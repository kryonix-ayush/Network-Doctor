# Replace all placeholder values before starting services. Never commit .env.
API_TOKEN=yfQRXgrhAb8aY3QmGl0QvvYu8WrqWaXGVYGNqKJ2MoE
LOCAL_AGENT_TOKEN=7qYws-4bVg0bMr2OP4FRuk76rRfeNSOANK6vb85NWMs
CLOUD_AGENT_TOKEN=i9hFTRvyqbdGIOin2PmpwMWLs9-cLH6caxzH5yRmU_c
AGENT_TOKENS={"network-doctor-local":"${LOCAL_AGENT_TOKEN}","network-doctor-cloud":"${CLOUD_AGENT_TOKEN}"}

# Use a hex secret for a URL-safe PostgreSQL password.
POSTGRES_PASSWORD=replace-with-64-hex-characters
DATABASE_URL=postgresql://networkdoctor:${POSTGRES_PASSWORD}@postgres:5432/networkdoctor
DATABASE_PATH=network_doctor.sqlite3

# Public DNS name for the HTTPS reverse proxy in compose.yaml.
NETWORK_DOCTOR_DOMAIN=monitor.example.com
API_BASE_URL=https://${NETWORK_DOCTOR_DOMAIN}

MONITOR_INTERVAL_SECONDS=10
DNS_TIMEOUT_SECONDS=2
TCP_TIMEOUT_SECONDS=3
HTTP_TIMEOUT_SECONDS=5
FAILURES_TO_OPEN_INCIDENT=3
SUCCESSES_TO_RESOLVE_INCIDENT=2
AGENT_HEARTBEAT_INTERVAL_SECONDS=30
AGENT_STALE_AFTER_SECONDS=90
MAX_CONCURRENT_CHECKS=20
RETENTION_DAYS=30
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_REQUEST_BYTES=1048576

# Optional alerts; leave empty to disable a channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=

# Only for explicitly controlled private cloud deployments. Leave disabled by default.
ALLOW_PRIVATE_CLOUD_TARGETS=false
CLOUD_PRIVATE_TARGETS_ACK=
